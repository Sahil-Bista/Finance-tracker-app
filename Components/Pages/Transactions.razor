@page "/transactions"
@using Corsework.Services
@using Corsework.Model
@inject NavigationManager Navigation
@inject dbService DbService
@inject dbDebtService debtdb
@inject dbUserService userDb
@inject TransactionService TransactionService
@inject IJSRuntime JS


<div class="container mt-4 p-4 border rounded shadow-sm bg-light">
    <h1 class="mb-3">Cash Outflows</h1>
    <div class="d-flex flex-wrap align-items-center">
        <p class="mb-0 me-4">Outflow Sum: @currencyType @OutflowAmount</p>
        <p class="mb-0 me-4">Highest Cash Outflow: @currencyType @highestOutFlow</p>
        <p class="mb-0">Lowest Cash Outflow: @currencyType @lowestOutFlow</p>
    </div>
    <br />
    <div class="d-flex flex-wrap align-items-center">
        <button class="btn btn-primary me-3" @onclick="RedirectToAddTransaction">
            Add Cash Outflow
        </button>
        <button class="btn btn-primary" @onclick="RedirectToCashOutFlow">
            View full history
        </button>
    </div>
    <br />
    <h3>5 latest cash Outflows</h3>
    <br>
    
    <table class="table">
        <thead class="thead-dark ">
            <tr>
                <th scope="col">TransactionName</th>
                <th scope="col">TransactionAmount (in @currencyType)</th>
                <th scope="col">TransactionTime</th>
                <th scope="col">TransactionType</th>
               
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in cashOutflows.Take(5))
            {
                <tr>
                    <td>@transaction.TransactionName</td>
                    <td>@transaction.TransactionAmount</td>
                    <td>@transaction.TransactionTime</td>
                    <td>@transaction.TransactionType</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="container mt-4 p-4 border rounded shadow-sm bg-light">
    <h1 class="mb-3">Cash Inflows</h1>
    <div class="d-flex flex-wrap align-items-center">
        <p class="mb-0 me-4">Inflow Sum: @currencyType @InflowAmount</p>
        <p class="mb-0 me-4">Highest Cash Inflow: @currencyType @highestInFlow</p>
        <p class="mb-0">Lowest Cash Inflow: @currencyType @lowestInFlow</p>
    </div>
    <br />
    <div class="d-flex flex-wrap align-items-center">
        <button class="btn btn-primary me-3" @onclick="RedirectToAddTransaction">
            Add Cash Inflow 
        </button>
        <button class="btn btn-primary" @onclick="RedirectToCashInFlow">
            View full history
        </button>
    </div>
    <br />
    <h3>5 latest cash inflows</h3>
    <br />
    <table class="table">
        <thead class="thead-dark ">
            <tr>
                <th scope="col">TransactionName</th>
                <th scope="col">TransactionAmount</th>
                <th scope="col">TransactionTime</th>
                <th scope="col">TransactionType</th>
               
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in cashInflows.Take(5))
            {
                <tr>
                    <td>@transaction.TransactionName</td>
                    <td>@transaction.TransactionAmount (in @currencyType)</td>
                    <td>@transaction.TransactionTime</td>
                    <td>@transaction.TransactionType</td>
                  
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<TransactionModel> transactions = new List<TransactionModel>();
    private List<TransactionModel> filteredTransactions = new List<TransactionModel>();
    private List<TransactionModel> cashOutflows = new List<TransactionModel>();
    private List<TransactionModel> cashInflows = new List<TransactionModel>();
    private List<DebtModel> debts = new List<DebtModel>();
    private List<DebtModel> unpaidDebts = new List<DebtModel>();
    private UserModel user;
    private double OutflowAmount;
    private double InflowAmount;
    private double Balance;
    private double debt;
    private DateTime startDate;
    private DateTime endDate;
    private double highestOutFlow;
    private double lowestOutFlow;
    private double highestInFlow;
    private double lowestInFlow;
    private double TotalUnpaidDebts;
    private string currencyType;


    protected override async Task OnInitializedAsync()
    {
        user = await userDb.GetUser();
        if (user != null)
        {
            currencyType = user.CurrencyType;
        }
        debts = await debtdb.GetDebts();
        unpaidDebts = debts.Where(d => d.IsCleared == false).ToList();
        TotalUnpaidDebts = unpaidDebts.Sum(d => d.DebtAmount);
        transactions = await DbService.GetTransactions();
        filteredTransactions = transactions.OrderByDescending(t => t.TransactionTime).ToList();
        cashOutflows = transactions.Where(t => t.TransactionType == "Debit").OrderByDescending(t => t.TransactionTime).ToList();
        OutflowAmount = cashOutflows.Sum(t => t.TransactionAmount);
        highestOutFlow = cashOutflows.Any() ? cashOutflows.Max(t => t.TransactionAmount) : 0;
        lowestOutFlow = cashOutflows.Any() ? cashOutflows.Min(t => t.TransactionAmount) : 0;
        cashInflows = transactions.Where(t => t.TransactionType == "Credit").OrderByDescending(t => t.TransactionTime).ToList();
        InflowAmount = cashInflows.Sum(t => t.TransactionAmount);
        highestInFlow = cashInflows.Any() ? cashInflows.Max(t => t.TransactionAmount) : 0;
        lowestInFlow = cashInflows.Any() ? cashInflows.Min(t => t.TransactionAmount) : 0;

        // Calculate balance
        debt = TotalUnpaidDebts;
        Balance = InflowAmount - OutflowAmount + debt;
        TransactionService.Balance = Balance;
    }

    private dbService _dbService = new dbService();

    private void RedirectToAddTransaction()
    {
        Navigation.NavigateTo("/addTransactions");
    }

    private void RedirectToCashOutFlow()
    {
        Navigation.NavigateTo("/cashOutFlow");
    }
    
    private void RedirectToCashInFlow()
    {
        Navigation.NavigateTo("/cashInFlow");
    }



    private void RedirectToAddDebt()
    {
        Navigation.NavigateTo("/addDebts");
    }
}
