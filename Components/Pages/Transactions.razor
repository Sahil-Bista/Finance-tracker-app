@page "/transactions"
@using Corsework.Services
@using Corsework.Model
@inject NavigationManager Navigation
@inject dbService DbService
@inject dbDebtService debtdb
@inject TransactionService TransactionService


<div class="container mt-4 p-4 border rounded shadow-sm bg-light">
    <h1 class="mb-3">Cash Outflows</h1>
    <div class="d-flex flex-wrap align-items-center">
        <p class="mb-0 me-4">Outflow Sum: @OutflowAmount</p>
        <p class="mb-0 me-4">Highest Cash Outflow: @highestOutFlow</p>
        <p class="mb-0">Lowest Cash Outflow: @lowestOutFlow</p>
    </div>
    <br />
    <div class="d-flex flex-wrap align-items-center">
        <button class="btn btn-primary me-3" @onclick="RedirectToAddTransaction">
            Add Cash Outflow
        </button>
        <button class="btn btn-primary">
            View full history
        </button>
    </div>
    <br />
    <h3>5 latest cash Outflows</h3>
    <br>
    
    <table class="table">
        <thead class="thead-dark ">
            <tr>
                <th scope="col">TransactionName</th>
                <th scope="col">TransactionAmount</th>
                <th scope="col">TransactionTime</th>
                <th scope="col">TransactionType</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in cashOutflows.Take(5))
            {
                <tr>
                    <td>@transaction.TransactionName</td>
                    <td>@transaction.TransactionAmount</td>
                    <td>@transaction.TransactionTime</td>
                    <td>@transaction.TransactionType</td>
                    <td>
                        <button @onclick="() => HandleDelete(transaction.TransactionId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="container mt-4 p-4 border rounded shadow-sm bg-light">
    <h1 class="mb-3">Cash Outflows</h1>
    <div class="d-flex flex-wrap align-items-center">
        <p class="mb-0 me-4">Inflow Sum: @InflowAmount</p>
        <p class="mb-0 me-4">Highest Cash Inflow: @highestInFlow</p>
        <p class="mb-0">Lowest Cash Inflow: @lowestInFlow</p>
    </div>
    <br />
    <div class="d-flex flex-wrap align-items-center">
        <button class="btn btn-primary me-3" @onclick="RedirectToAddTransaction">
            Add Cash Inflow 
        </button>
        <button class="btn btn-primary">
            View full history
        </button>
    </div>
    <br />
    <h3>5 latest cash inflows</h3>
    <br />
    <table class="table">
        <thead class="thead-dark ">
            <tr>
                <th scope="col">TransactionName</th>
                <th scope="col">TransactionAmount</th>
                <th scope="col">TransactionTime</th>
                <th scope="col">TransactionType</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in cashInflows.Take(5))
            {
                <tr>
                    <td>@transaction.TransactionName</td>
                    <td>@transaction.TransactionAmount</td>
                    <td>@transaction.TransactionTime</td>
                    <td>@transaction.TransactionType</td>
                    <td>
                        <button @onclick="() => HandleDelete(transaction.TransactionId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<TransactionModel> transactions = new List<TransactionModel>();
    private List<TransactionModel> filteredTransactions = new List<TransactionModel>();
    private List<TransactionModel> cashOutflows = new List<TransactionModel>();
    private List<TransactionModel> cashInflows = new List<TransactionModel>();
    private double OutflowAmount;
    private Double InflowAmount;
    private Double Balance;
    private Double debt;
    private DateTime startDate;
    private DateTime endDate;
    private Double highestOutFlow;
    private Double lowestOutFlow;
    private Double highestInFlow;
    private Double lowestInFlow;


    protected override async Task OnInitializedAsync()
    {
        transactions = await DbService.GetTransactions();
        filteredTransactions = transactions.ToList();
        cashOutflows = transactions.Where(t => t.TransactionType == "Debit").OrderByDescending(t => t.TransactionTime).ToList();
        OutflowAmount = cashOutflows.Sum(t => t.TransactionAmount);
        highestOutFlow = cashOutflows.Max(t => t.TransactionAmount);
        lowestOutFlow = cashOutflows.Min(t => t.TransactionAmount);
        cashInflows = transactions.Where(t => t.TransactionType == "Credit").OrderByDescending(t => t.TransactionTime).ToList();
        InflowAmount = cashInflows.Sum(t => t.TransactionAmount);
        highestInFlow = cashInflows.Max(t => t.TransactionAmount);
        lowestInFlow = cashInflows.Min(t => t.TransactionAmount);
        Balance = InflowAmount - OutflowAmount;
        TransactionService.Balance = Balance;
        debt = TransactionService.Debt;
    }

    private dbService _dbService = new dbService();

    private async Task HandleDelete(Guid transaction)
    {
        try
        {
            await _dbService.DeleteById(transaction);
            Console.WriteLine("Transaction deleted successfully!");
            transactions = await DbService.GetTransactions();
            cashOutflows = transactions.Where(t => t.TransactionType == "Debit").ToList();
            cashInflows = transactions.Where(t => t.TransactionType == "Credit").ToList();
            Balance = InflowAmount - OutflowAmount ;
            TransactionService.Balance = Balance;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void RedirectToAddTransaction()
    {
        Navigation.NavigateTo("/addTransactions");
    }

    private void RedirectToAddDebt()
    {
        Navigation.NavigateTo("/addDebts");
    }

    private void SortByDate()
    {
        transactions = filteredTransactions.OrderByDescending(t => t.TransactionTime).ToList();
    }

    private void  UpdateFilteredTransactions(string searchTerm)
    {
        filteredTransactions = transactions.ToList();

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredTransactions = filteredTransactions
                .Where(t => t.TransactionName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            t.TransactionType.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            (t.TransactionCustomTags != null && t.TransactionCustomTags.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }

        if (startDate != default(DateTime) && endDate != default(DateTime))
        {
            filteredTransactions = filteredTransactions
                .Where(t => t.TransactionTime >= startDate && t.TransactionTime <= endDate)
                .ToList();
        }

        StateHasChanged();


    }
}
