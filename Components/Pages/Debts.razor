@page "/debts"
@using Corsework.Services
@using Corsework.Model
@inject NavigationManager Navigation
@inject dbUserService userDb
@inject TransactionService TransactionService;
@inject IJSRuntime JS;

<div class="container mt-4 p-4 border rounded shadow-sm bg-light">
    <h1 class="mb-3">Debts</h1>
    <div class="d-flex flex-wrap align-items-center">
        <p class="mb-0 me-4">Total Balance : @currencyType @TotalBalanceWithDebt</p>
        <p class="mb-0 me-4">Remaining debt : @currencyType @TotalUnpaidDebts</p>
        <p class="mb-0 me-4">Cleared Debt : @currencyType @PaidDebts</p>
        <p class="mb-0 me-4">Highest Debt : @currencyType @highestDebt</p>
        <p class="mb-0">Lowest Debt : @currencyType @lowestDebt</p>
    </div>
    <br />
    <div class="d-flex flex-wrap align-items-center">
        <button class="btn btn-primary me-3" @onclick="RedirectToAddDebt">
            Add Debt
        </button>
    </div>
    <br />
    <h3> Debts</h3>
    <br>
    @if(debts != null && debts.Any())
    {
    <table class="table">
        <thead class="thead-dark ">
            <tr>
                <th scope="col">Debt Source</th>
                <th scope="col">Debt Amount( in @currencyType)</th>
                <th scope="col">Due Date</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var debt in debts)
            {
                <tr style="@((!debt.IsCleared) ? "background-color: #F08080;" : "")">
                    <td>@debt.DebtSource</td>
                    <td>@debt.DebtAmount</td>
                    <td>@debt.DueDate</td>
                    
                    @if (@debt.IsCleared == false)
                        {
                            <td>
                                <button type="submit" @onclick="() => HandleDelete(debt.DebtId)"> Clear Debt </button>
                            </td>
                        }
                </tr>
            }
        </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No debts to display. Add new debts using the button above.
        </div>
    }
</div>


@code {
    private List<DebtModel> debts = new List<DebtModel>();
    private List<DebtModel> unpaidDebts = new List<DebtModel>();
    private List<DebtModel> paidDebts = new List<DebtModel>();
    private UserModel user;
    private double TotalDebt;
    private double TotalBalanceWithDebt;
    private double TotalUnpaidDebts;
    private double PaidDebts;
    private string currencyType;
    private double highestDebt;
    private double lowestDebt;
    private dbDebtService _dbService = new dbDebtService();

    protected override async Task OnInitializedAsync()
    {
        user = await userDb.GetUser();
        if (user != null)
        {
            currencyType = user.CurrencyType;
        }
        debts = await _dbService.GetDebts();
        if (debts == null)
        {
            debts = new List<DebtModel>(); // Initializing to an empty list if null
        }
        debts = debts.OrderByDescending(d => d.DueDate).ToList();
        highestDebt = debts.Count>0 ? debts.Max(d => d.DebtAmount) : 0;
        lowestDebt = debts.Any() ? debts.Min(d => d.DebtAmount) : 0;
        unpaidDebts = debts.Where(d => d.IsCleared == false).ToList();
        TotalUnpaidDebts = unpaidDebts.Count > 0 ? unpaidDebts.Sum(d => d.DebtAmount) : 0;
        paidDebts = debts.Where(d => d.IsCleared == true).ToList();
        PaidDebts = paidDebts.Count>0 ? paidDebts.Sum(d => d.DebtAmount):0;
        TotalBalanceWithDebt = TransactionService.Balance;
    }

    private async Task HandleDelete(Guid debt)
    {
        try
        {
            var debtToDelete = await _dbService.GetById(debt);
            var amount = debtToDelete.DebtAmount;

            if( amount <= TotalBalanceWithDebt)
            {
                bool isCleared = await _dbService.ClearDebt(debt);
                if (isCleared)
                {
                    TotalBalanceWithDebt -= amount;
                    Console.WriteLine("Transaction added successfully!");
                    debts = await _dbService.GetDebts();
                    StateHasChanged();
                }
                else
                {
                    Console.WriteLine("Failed to clear debt");
                }
            }
            else
            {
                await JS.InvokeVoidAsync("showAlert", "Insufficient balance");  
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void RedirectToAddTransaction()
    {
        Navigation.NavigateTo("/addTransactions");
    }

    private void RedirectToAddDebt()
    {
        Navigation.NavigateTo("/addDebts");
    }
}
