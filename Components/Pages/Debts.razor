@page "/debts"
@using Corsework.Services
@using Corsework.Model
@inject NavigationManager Navigation
@inject TransactionService TransactionService;
@inject IJSRuntime JS;

<div>

    <h1>Debts</h1>
    <p>Total Debt : @TotalDebt</p>
    <p>Total Balance With Debt : @TotalBalanceWithDebt</p>
    <p>Remaining debt : @TotalUnpaidDebts</p>
    <p>Cleared Debt : @PaidDebts</p>
    <p></p>
    <div>
        <ul>
            @foreach (var debt in debts)
            {
                <li style="@(debt.IsCleared==false ? "background-color: goldenrod;" : "")">
                    @debt.DebtSource
                    @debt.DebtAmount
                    @debt.IsCleared
                    @if(@debt.IsCleared == false){
                    <button type="submit" @onclick="() => HandleDelete(debt.DebtId)"> Clear Debt </button>
                    }
                </li>
            }
        </ul>
    </div>

</div>

<div>
    <button @onclick="RedirectToAddTransaction">
        Add Transaction
    </button>
</div>

<div>
    <button @onclick="RedirectToAddDebt">
        Add Debt
    </button>
</div>


@code {
    private List<DebtModel> debts = new List<DebtModel>();
    private List<DebtModel> unpaidDebts = new List<DebtModel>();
    private List<DebtModel> paidDebts = new List<DebtModel>();
    private double TotalDebt;
    private double TotalBalanceWithDebt;
    private double TotalUnpaidDebts;
    private double PaidDebts;
    private dbDebtService _dbService = new dbDebtService();

    protected override async Task OnInitializedAsync()
    {
        debts = await _dbService.GetDebts();
        debts = debts.OrderByDescending(d => d.DueDate).ToList();
        TotalDebt = debts.Sum(d => d.DebtAmount);
        unpaidDebts = debts.Where(d => d.IsCleared == false).ToList();
        TotalUnpaidDebts = unpaidDebts.Sum(d => d.DebtAmount);
        paidDebts = debts.Where(d => d.IsCleared == true).ToList();
        PaidDebts = paidDebts.Sum(d => d.DebtAmount);
        TransactionService.Debt = TotalDebt;
        TotalBalanceWithDebt = TransactionService.Balance + TransactionService.Debt;
    }

    private async Task HandleDelete(Guid debt)
    {
        try
        {
            var debtToDelete = await _dbService.GetById(debt);
            var amount = debtToDelete.DebtAmount;

            if( amount <= TotalBalanceWithDebt)
            {
                bool isCleared = await _dbService.ClearDebt(debt);
                if (isCleared)
                {
                    TotalBalanceWithDebt -= amount;
                    Console.WriteLine("Transaction added successfully!");
                    debts = await _dbService.GetDebts();
                    StateHasChanged();
                }
                else
                {
                    Console.WriteLine("Failed to clear debt");
                }
            }
            else
            {
                await JS.InvokeVoidAsync("showAlert", "Insufficient balance");  // Show specific erro
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void RedirectToAddTransaction()
    {
        Navigation.NavigateTo("/addTransactions");
    }

    private void RedirectToAddDebt()
    {
        Navigation.NavigateTo("/addDebts");
    }
}
