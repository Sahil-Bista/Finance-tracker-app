@page "/home"
@using Corsework.Services
@using Corsework.Model
@inject NavigationManager Navigation
@inject dbService DbService
@inject dbDebtService debtdb
@inject TransactionService TransactionService
@inject IJSRuntime JS


<div class="container mt-4 p-4 border rounded shadow-sm bg-light">
    <h1 class="mb-3">Transactions</h1>
    <h2 class="mb-4">Balance: <span class="text-success">@TransactionService.Balance</span></h2>

    <div class="row g-2 align-items-center">

        <div class="col-auto">
            <input type="date" id="startDate" class="form-control" placeholder="Start Date"
                   @bind="startDate" />
        </div>

        <div class="col-auto">
            <input type="date" id="endDate" class="form-control" placeholder="End Date"
                   @bind="endDate" />
        </div>

        <div class="col-auto">
            <SearchBar OnSearch="UpdateFilteredTransactions" ></SearchBar>
        </div>

        <div class="col-auto">
            <button class="btn btn-primary" @onclick="SortTransactionOrder">Sort by Date</button>
        </div>

    </div>


    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead class="thead-dark">
                <tr>
                    <th scope="col">TransactionName</th>
                    <th scope="col">TransactionAmount</th>
                    <th scope="col">TransactionTime</th>
                    <th scope="col">TransactionType</th>
                    <th scope="col">TransactionSource</th>
                    <th scope="col">TransactionNotes</th>
                    <th scope="col">TransactionTags</th>
                    <th scope="col">TransactionCustomTags</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in filteredTransactions)
                {
                    <tr>
                        <td>@transaction.TransactionName</td>
                        <td>@transaction.TransactionAmount</td>
                        <td>@transaction.TransactionTime</td>
                        <td>@transaction.TransactionType</td>
                        <td>@transaction.TransactionSource</td>
                        <td>@transaction.TransactionNotes</td>
                        <td>@transaction.TransactionDefaultTag</td>
                        <td>@transaction.TransactionCustomTags</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>




@code {
    private List<TransactionModel> transactions = new List<TransactionModel>();
    private List<TransactionModel> filteredTransactions = new List<TransactionModel>();
    private List<TransactionModel> cashOutflows = new List<TransactionModel>();
    private List<TransactionModel> cashInflows = new List<TransactionModel>();
    private List<DebtModel> debts = new List<DebtModel>();
    private List<DebtModel> unpaidDebts = new List<DebtModel>();
    private double OutflowAmount;
    private Double InflowAmount;
    private Double Balance;
    private Double TotalUnpaidDebts;
    private DateTime startDate;
    private DateTime endDate;
    private bool isAscending = true;

    protected override async Task OnInitializedAsync()
    {
        debts = await debtdb.GetDebts();
        unpaidDebts = debts.Where(d => d.IsCleared == false).ToList();
        TotalUnpaidDebts = unpaidDebts.Sum(d => d.DebtAmount);
        transactions = await DbService.GetTransactions();
        filteredTransactions = transactions.ToList().OrderByDescending(t => t.TransactionTime).ToList(); ;
        cashOutflows = transactions.Where(t => t.TransactionType == "Debit").OrderByDescending(t => t.TransactionTime).ToList();
        OutflowAmount = cashOutflows.Sum(t => t.TransactionAmount);
        cashInflows = transactions.Where(t => t.TransactionType == "Credit").OrderByDescending(t => t.TransactionTime).ToList();
        InflowAmount = cashInflows.Sum(t => t.TransactionAmount);
        Balance = InflowAmount - OutflowAmount + TotalUnpaidDebts;
        TransactionService.Balance = Balance;
    }

    private dbService _dbService = new dbService();

        private void SortTransactionOrder()
    {
        isAscending = !isAscending; // Toggle the sort order

        if (isAscending)
        {
            filteredTransactions = filteredTransactions.OrderBy(t => t.TransactionTime).ToList();
        }
        else
        {
            filteredTransactions = filteredTransactions.OrderByDescending(t => t.TransactionTime).ToList();
        }

        StateHasChanged(); // Refresh the UI
    }

    private void RedirectToAddTransaction()
    {
        Navigation.NavigateTo("/addTransactions");
    }

    private void RedirectToAddDebt()
    {
        Navigation.NavigateTo("/addDebts");
    }

    private async Task UpdateFilteredTransactions(string searchTerm)
    {
        filteredTransactions = transactions.ToList();

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredTransactions = filteredTransactions
                .Where(t => t.TransactionName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            t.TransactionType.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            (t.TransactionDefaultTag != null && t.TransactionDefaultTag.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }

        if (startDate != default(DateTime) && endDate != default(DateTime))
        {
            if (startDate < endDate)
            {
                filteredTransactions = filteredTransactions
                    .Where(t => t.TransactionTime >= startDate && t.TransactionTime <= endDate)
                    .ToList();
            }
            else
            {
                Console.WriteLine("Invalid date range.");
                await JS.InvokeVoidAsync("showAlert", "End date cannot be less than start date");
            }
        }

        filteredTransactions = filteredTransactions.OrderByDescending(t => t.TransactionTime).ToList();

        StateHasChanged();
    }
}
