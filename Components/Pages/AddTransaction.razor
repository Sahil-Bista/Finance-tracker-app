@page "/addTransactions"
@using Corsework.Services;
@using Corsework.Model;
@using Corsework.Components.Layout;
@inject NavigationManager Navigation;
@using System.ComponentModel.DataAnnotations;
@inject IJSRuntime JS;
@inject TransactionService TransactionService;
@layout CustomLayout

<div class="container mt-4 p-4 border rounded shadow-sm bg-light">
    <h3 class="mb-4 text-center">Add Transaction</h3>

    <EditForm Model="@transactionModel" OnSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row">
            <!-- Transaction Name -->
            <div class="col-md-6 mb-3">
                <label for="transactionName" class="form-label">Transaction Name</label>
                <InputText id="transactionName"
                           @bind-Value="transactionModel.TransactionName"
                           class="form-control"
                           placeholder="Add transaction name here" />
            </div>

            <!-- Transaction Amount -->
            <div class="col-md-6 mb-3">
                <label for="transactionAmount" class="form-label">Transaction Amount</label>
                <InputNumber id="transactionAmount"
                             @bind-Value="transactionModel.TransactionAmount"
                             class="form-control"
                             placeholder="Enter transaction amount" />
            </div>
        </div>

        <div class="row">
            <!-- Transaction Type -->
            <div class="col-md-6 mb-3">
                <label for="transactionType" class="form-label">Transaction Type</label>
                <select id="transactionType"
                        @bind="transactionModel.TransactionType"
                        class="form-control">
                    <option value="Credit">Credit</option>
                    <option value="Debit">Debit</option>
                </select>
            </div>

            <!-- Transaction Source -->
            <div class="col-md-6 mb-3">
                <label for="transactionSource" class="form-label">Transaction Source</label>
                <InputText id="transactionSource"
                           @bind-Value="transactionModel.TransactionSource"
                           class="form-control"
                           placeholder="Enter transaction source" />
            </div>
        </div>

        <div class="row">
            <!-- Transaction Time -->
            <div class="col-md-6 mb-3">
                <label for="transactionTime" class="form-label">Transaction Time</label>
                <InputDate id="transactionTime"
                           @bind-Value="transactionModel.TransactionTime"
                           class="form-control" />
            </div>

            <!-- Transaction Notes -->
            <div class="col-md-6 mb-3">
                <label for="transactionCustomTags" class="form-label">Transaction Tags (Optional)</label>
                <InputText id="transactionCustomTags"
                           @bind-Value="transactionModel.TransactionCustomTags"
                           class="form-control"
                           placeholder="Add transaction tags" />
                
            </div>
        </div>

        <div class="row">
            <!-- Transaction Notes -->
            <div class="col-md-6 mb-3">
                <label for="transactionNotes" class="form-label">Transaction Notes (Optional)</label>
                <InputText id="transactionNotes"
                           @bind-Value="transactionModel.TransactionNotes"
                           class="form-control"
                           placeholder="Add transaction notes" />
            </div>
            <!--Yearly, Monthly, Food, Drinks, Clothes, Gadgets, Miscellaneous, Fuel, Rent, EMI, Party-->
            <div class="col-md-6 mb-3">
                <label for="defaultTags" class="form-label">Default Tags</label>
                <select id="DefaultTags"
                        @bind="transactionModel.TransactionDefaultTag"
                        class="form-control">
                    <option value="Food">Food</option>
                    <option value="Drinks">Drinks</option>
                    <option value="Clothes">Clothes</option>
                    <option value="Gadgets">Gadgets</option>
                    <option value="Miscellaneous">Miscellaneous</option>
                    <option value="Fuel">Fuel</option>
                    <option value="Rent">Rent</option>
                    <option value="EMI">EMI</option>
                    <option value="Party">Party</option>
                    <option value="Salary">Salary</option>
                    <option value="Others">Others</option>
                </select>
            </div>
        </div>
       

        <!-- Submit Button -->
        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary px-4 py-2">Add Transaction</button>
        </div>
    </EditForm>

    <!-- Navigation Link -->
    <div class="mt-4 text-center">
        <p>
            Want to view transactions?
            <NavLink href="/transactions" class="text-primary text-decoration-underline">
                View Transactions
            </NavLink>
        </p>
    </div>
</div>

@code {
    private TransactionModel transactionModel = new TransactionModel();
    private dbService _dbService = new dbService();


    private async Task HandleSubmit()
    {
        var validationResults = new List<ValidationResult>();
        var validationContext = new ValidationContext(transactionModel);

        bool isValid = Validator.TryValidateObject(transactionModel, validationContext, validationResults, true);

        if (!isValid)
        {
            // Shows validation errors - customized for different error types
            foreach (var validationResult in validationResults)
            {
                Console.WriteLine(validationResult.ErrorMessage);
                await JS.InvokeVoidAsync("showAlert", validationResult.ErrorMessage); 
            }
            return; 
        }
        try
        {
            var balance = TransactionService.Balance;
            if(transactionModel.TransactionAmount > balance && transactionModel.TransactionType=="Debit")
            {
                var insufficientAmount = -(balance - transactionModel.TransactionAmount);
                Console.WriteLine("Balance insufficient for transaction");
                await JS.InvokeVoidAsync("showAlert", $"balance Insufficient by ${insufficientAmount}");
                return;
            }
            await _dbService.Create(transactionModel);
            Console.WriteLine("Transaction added successfully!");
            transactionModel = new TransactionModel(); // Clears the form
            Navigation.NavigateTo("/transactions");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}
